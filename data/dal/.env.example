# ===================================================
# DAL Environment Configuration
# Copy to .env and fill in values for local development
# ===================================================

# --- Application ---
APP_NAME=dal
APP_ENV=development
APP_PORT=8010
DEBUG=true
LOG_LEVEL=DEBUG
DOCS_ENABLED=true
DAL_LOCAL_API_KEY=your-dal-local-api-key

# --- Metadata Database (PostgreSQL) ---
METADATA_DB_HOST=localhost
METADATA_DB_PORT=5433
METADATA_DB_USER=dal_meta
METADATA_DB_PASSWORD=your-metadata-db-password
METADATA_DB_NAME=dal_metadata

# --- Operational Database (PostgreSQL) ---
OPERATIONAL_DB_HOST=localhost
OPERATIONAL_DB_PORT=5434
OPERATIONAL_DB_USER=dal_ops
OPERATIONAL_DB_PASSWORD=your-operational-db-password
OPERATIONAL_DB_NAME=dal_operational

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Rate Limiting ---
DEFAULT_RATE_LIMIT_PER_MINUTE=10

# --- Query Defaults ---
DEFAULT_QUERY_LIMIT=100
MAX_QUERY_LIMIT=10000
