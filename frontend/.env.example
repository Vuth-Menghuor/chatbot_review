# Frontend connects directly to the API layer. The API layer must allow this
# frontend origin through CORS during development.
NUXT_PUBLIC_GDCE_API_ENABLED=true
NUXT_PUBLIC_GDCE_API_BASE_URL=http://localhost:8000
NUXT_PUBLIC_MAX_IMAGE_SIZE_MB=5
NUXT_PUBLIC_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
# Development-only browser login. Do not use public credentials in production.
NUXT_PUBLIC_GDCE_DEV_EMAIL=frontend-dev@example.com
NUXT_PUBLIC_GDCE_DEV_PASSWORD=password123
