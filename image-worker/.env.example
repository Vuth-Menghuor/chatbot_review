# Image worker — env vars are usually injected by backend/api-layer/docker-compose.yml
# Copy to .env only when running the worker standalone.

DATABASE_URL=postgresql://api_user:your-db-password@api-postgres:5432/api_layer_db
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=chatbot-files
MINIO_SECURE=false
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=your-rabbitmq-password
RABBITMQ_IMAGE_QUEUE=image_jobs
