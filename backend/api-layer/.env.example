# API Layer — port 8000
# Setup: cp .env.example .env  (fill JWT_SECRET_KEY and infra passwords)
# Run: docker compose up -d --build

ENVIRONMENT=development
DEBUG=false
ENABLE_DOCS=true

DATABASE_URL=postgresql+asyncpg://api_user:your-db-password@api-postgres:5432/api_layer_db
REDIS_URL=redis://api-redis:6379/0
MAIN_CHATBOT_SERVICE_URL=http://orchestrator-service-orches:8001
ENABLE_CHAT_RESPONSE_DEBUG=false
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
REFRESH_TOKEN_EXPIRE_DAYS=7
# Refresh tokens are HttpOnly cookies and are never returned to browser JavaScript.
REFRESH_COOKIE_NAME=gdce_refresh
REFRESH_COOKIE_SAMESITE=lax
# Set this only when a shared cookie domain is required, e.g. .example.gov.kh.
REFRESH_COOKIE_DOMAIN=
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
API_RESPONSE_CACHE_SECONDS=30
HTTP_TIMEOUT_SECONDS=60
# Use the orchestrator's live /query/stream endpoint. Set true only when a
# deployment must wait for the completed /query response before rendering.
USE_STANDARD_CHAT_STREAM=false
GENERAL_RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
# Retention cleanup runs in the API layer; keep these values aligned with the published policy.
RETENTION_CLEANUP_ENABLED=true
RETENTION_CLEANUP_INTERVAL_SECONDS=86400
CHAT_RETENTION_DAYS=90
DELETED_CHAT_RETENTION_DAYS=30
DELETED_FILE_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365
CHATBOT_DOCKER_NETWORK=gdce-network

# Postgres (used by docker-compose for api-postgres service)
POSTGRES_DB=api_layer_db
POSTGRES_USER=api_user
POSTGRES_PASSWORD=your-db-password

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=chatbot-files
MINIO_SECURE=false

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=your-rabbitmq-password
RABBITMQ_IMAGE_QUEUE=image_jobs

MAX_IMAGE_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
