# =====================================================
# GEMINI API CONFIGURATION
# =====================================================
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_ENABLED=true
GEMINI_MODEL="gemini-2.0-flash-lite"


# OPEN ROUTER
OPENROUTER_API_KEY="your-openrouter-api-key-here"

# =====================================================
# ORCHESTRATOR SERVICE (Port 8001)
# =====================================================
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8001
ORCHESTRATOR_RELOAD=false
ORCHESTRATOR_WORKERS=4
LOG_LEVEL=INFO

# =====================================================
# DOWNSTREAM SERVICE URLS
# =====================================================
RETRIEVAL_SERVICE_URL=http://127.0.0.1:8003
CALCULATOR_SERVICE_URL=http://127.0.0.1:8002
TRADE_DATA_SERVICE_URL=http://127.0.0.1:8004
GENERAL_SERVICE_URL=http://127.0.0.1:8005

# =====================================================
# RETRIEVAL / VECTOR STORE
# =====================================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_SEARCH_COLLECTION=gdce_docs
QDRANT_COLLECTION_NAME=gdce_docs
QDRANT_HS_CODE_COLLECTION=gdce_hs_code
QDRANT_HS_CODE_EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200

# =====================================================
# DATABASE
# =====================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=gdce_hs_code
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gdce_hs_code
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password-here

# =====================================================
# EMBEDDING AND SEARCH
# =====================================================
QUERY_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_ENABLED=true
SIMILARITY_THRESHOLD=0.1
TOP_K_DEFAULT=10
TOP_K_MAX=50

# =====================================================
# CALCULATOR SERVICE
# =====================================================
CALCULATOR_HOST=127.0.0.1
CALCULATOR_PORT=8002
CALCULATOR_RELOAD=false
USD_TO_KHR_RATE=4022.0
DUTY_RATES_CSV_PATH=./data/processed/structured/duty_rates.csv

# =====================================================
# RETRIEVAL SERVICE
# =====================================================
RETRIEVAL_HOST=127.0.0.1
RETRIEVAL_PORT=8003
RETRIEVAL_RELOAD=false
RETRIEVAL_WORKERS=2

# =====================================================
# TRADE QUERY SERVICE
# =====================================================
TRADE_SERVICE_HOST=127.0.0.1
TRADE_SERVICE_PORT=8004
TRADE_DB_HOST=127.0.0.1
TRADE_DB_PORT=5432
TRADE_DB_NAME=postgres
TRADE_DB_USER=postgres
TRADE_DB_PASSWORD=your-db-password-here
TRADE_DB_SCHEMA=trade_raw
TRADE_DB_TABLE=trade_data_202603181513

# =====================================================
# INTENT DETECTION MODELS
# =====================================================
INTENT_DETECTION_MODEL=all-MiniLM-L12-v2
INTENT_CONFIDENCE_THRESHOLD=0.65
INTENT_DETECTION_TIMEOUT_MS=1000
CURRENCY_DETECTION_MODEL=all-MiniLM-L12-v2
CURRENCY_CONFIDENCE_THRESHOLD=0.70
POSTGRESQL_EXCHANGE_RATE_ENABLED=true

# =====================================================
# OLLAMA (local LLM fallback)
# =====================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# =====================================================
# CIRCUIT BREAKER
# =====================================================
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30

# =====================================================
# REQUEST TIMEOUTS
# =====================================================
REQUEST_TIMEOUT_SECONDS=30
SERVICE_HEALTH_CHECK_INTERVAL_SECONDS=10

# =====================================================
# CACHE
# =====================================================
CACHE_ENABLED=false
CACHE_TTL_SECONDS=300

# =====================================================
# REDIS & ARCHIVING
# =====================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
TRANSCRIPT_FLUSH_INTERVAL=300
REDIS_RETENTION_TURNS=20
POSTGRES_RETENTION_DAYS=67

# PostgreSQL archiving database credentials
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=postgres_database_name
PG_USER=postgres_username
PG_PASSWORD=your_postgres_password
