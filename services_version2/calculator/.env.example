# =====================================================
# CALCULATOR SERVICE (Port 8002)
# Copy to .env and fill in secrets before running.
# =====================================================

CALCULATOR_HOST=127.0.0.1
CALCULATOR_PORT=8002
CALCULATOR_RELOAD=false
CALCULATOR_VERSION=2.0.0

# --- Downstream / upstream services ---
RETRIEVAL_SERVICE_URL=http://127.0.0.1:8003
ORCHESTRATOR_SERVICE_URL=http://127.0.0.1:8001

# --- LLM (optional formatting / intent) ---
CALCULATOR_LLM_HOST=127.0.0.1
CALCULATOR_LLM_PORT=11434
CALCULATOR_LLM_MODEL=kimi-k2.6:cloud
CALCULATOR_LLM_ENABLED=true
CALCULATOR_INTENT_LLM_ENABLED=true
GEMINI_API_KEY=your-gemini-api-key-here

# --- Calculator database (optional) ---
CALCULATOR_DB_HOST=localhost
CALCULATOR_DB_PORT=5432
CALCULATOR_DB_NAME=gdce_calculator
CALCULATOR_DB_USER=calc_app
CALCULATOR_DB_PASSWORD=your-db-password-here
CALCULATOR_DB_SSL_MODE=disable

# --- Admin / rules ---
ADMIN_API_KEY=your-admin-api-key-here
RULES_DB_ENABLED=true
RULES_CACHE_TTL_SECONDS=300

# --- Data paths ---
DUTY_RATES_CSV_PATH=./data/processed/structured/duty_rates.csv
USD_TO_KHR_RATE=4022.0

# --- Security ---
ALLOWED_ORIGINS=*
RATE_LIMIT_REQUESTS=60
MAX_PAYLOAD_SIZE_MB=5
LOG_LEVEL=INFO

# --- Docker overrides (uncomment when using docker compose) ---
# CALCULATOR_HOST=0.0.0.0
# RETRIEVAL_SERVICE_URL=http://retrieval:8003
