{
  "version": "1.0",
  "effective_date": "2026-01-01",
  "jurisdiction": "Cambodia",
  "issuing_authority": "GDCE (General Department of Customs and Excise)",
  "description": "Main configuration for Cambodia customs duty and tax calculations",
  "currency": {
    "default": "KHR",
    "exchange_rate_source": "configs/exchange_rates.json",
    "conversion_rule": "USD to KHR using official MEF rates"
  },
  "vat": {
    "standard_rate": 0.1,
    "description": "Value Added Tax (VAT)",
    "applies_to": "All goods imported for home use",
    "notes": "10% VAT is standard for all goods unless exempted"
  },
  "customs_duty": {
    "default_research_base_rate": 0.25,
    "description": "Customs Duty rates vary by HS code and origin",
    "application": {
      "all_goods": "Lookup HS code in HS tariff schedule",
      "fta_goods": "Check for FTA certificate (ATIGA, CPTPP, ASEAN, etc)",
      "agricultural": "Variable rates by product",
      "industrial": "Variable rates by product",
      "textiles": "Variable rates"
    },
    "special_cases": {
      "beer": {
        "hs_code": "2204",
        "general_rate": 0.2,
        "description": "Beer and similar beverages",
        "origin": "Any",
        "certificate_required": false,
        "notes": "20% CD for beer imports"
      },
      "spirits": {
        "hs_code": "2208",
        "general_rate": 0.2,
        "description": "Spirits and liqueurs",
        "origin": "Any",
        "certificate_required": false,
        "notes": "20% CD for spirits"
      },
      "smartphones": {
        "hs_code": "8517.62",
        "general_rate": 0.25,
        "fta_rate_atiga": 0.0,
        "description": "Smartphones and mobile devices",
        "origin": "ASEAN/FTA countries",
        "certificate_required": true,
        "certificate_type": "ATIGA Form D or equivalent",
        "notes": "0% CD with valid ATIGA Form D from Vietnam, Thailand, etc"
      },
      "medical_equipment": {
        "hs_code": "9018",
        "general_rate": 0.0,
        "description": "Medical, surgical instruments and apparatus",
        "origin": "Any",
        "certificate_required": false,
        "notes": "0% CD for medical equipment (exempted under investment law)"
      },
      "machinery": {
        "hs_code": "84",
        "general_rate": 0.1,
        "description": "Industrial machinery",
        "origin": "Any",
        "certificate_required": false,
        "notes": "Variable by type, typically 10%"
      }
    }
  },
  "special_tax": {
    "standard_rate": 0.1,
    "description": "Special Tax (excise-like tax on selected goods)",
    "applies_to": "Specific goods: alcohol, tobacco, energy drinks, luxury items",
    "special_rates": {
      "beer": {
        "rate": 0.3,
        "hs_code": "2204",
        "description": "30% ST on beer",
        "notes": "Applied to all beer regardless of origin"
      },
      "spirits": {
        "rate": 0.35,
        "hs_code": "2208",
        "description": "35% ST on spirits",
        "notes": "Applied to all spirits"
      },
      "tobacco": {
        "rate": 0.5,
        "hs_code": "2402-2403",
        "description": "50% ST on tobacco products",
        "notes": "Standard tobacco excise"
      },
      "energy_drinks": {
        "rate": 0.2,
        "hs_code": "2202",
        "description": "20% ST on energy drinks",
        "notes": "Applied to non-alcoholic energy/sports drinks"
      },
      "medical_equipment": {
        "rate": 0.0,
        "hs_code": "9018",
        "description": "0% ST on medical equipment",
        "notes": "Medical equipment exempted (investment law)"
      },
      "smartphones": {
        "rate": 0.05,
        "hs_code": "8517.62",
        "certificate_fta": "ATIGA",
        "origin": "ASEAN",
        "description": "5% ST on smartphones with ATIGA",
        "notes": "General ST of 10% reduced to 5% with valid ATIGA certificate"
      },
      "default_industrial": {
        "rate": 0.1,
        "description": "Default 10% ST for industrial goods",
        "applies_when": "No special rate defined"
      }
    }
  },
  "fta": {
    "description": "Preferential rates for FTA members",
    "agreements": {
      "atiga": {
        "name": "ASEAN Trade in Goods Agreement",
        "members": [
          "Vietnam",
          "Thailand",
          "Indonesia",
          "Philippines",
          "Singapore",
          "Malaysia",
          "Brunei",
          "Laos",
          "Myanmar",
          "Cambodia"
        ],
        "certificate_type": "ATIGA Form D (Certificate of Origin)",
        "certificate_validity": "12 months",
        "customs_duty_reduction": "0% (eligible goods)",
        "special_tax_reduction": "Often 50% reduction or specific rate",
        "validation_required": true,
        "stamp_required": "Issuing country chamber of commerce",
        "notes": "Most common FTA for Cambodia"
      },
      "cptpp": {
        "name": "Comprehensive and Progressive Trans-Pacific Partnership",
        "members": [
          "Vietnam",
          "Japan",
          "Australia",
          "Canada",
          "Chile",
          "Mexico",
          "New Zealand",
          "Singapore",
          "Thailand",
          "Malaysia",
          "Brunei"
        ],
        "customs_duty_reduction": "0-5% (eligible goods)",
        "special_tax_reduction": "Variable",
        "certificate_type": "CPTPP Certificate of Origin",
        "validation_required": true
      },
      "asean_framework": {
        "name": "ASEAN Common Effective Preferential Tariff (CEPT)",
        "members": [
          "ASEAN member states"
        ],
        "customs_duty_reduction": "0-5% (eligible goods)",
        "validation_required": true
      }
    }
  },
  "exemptions": {
    "diplomatic_goods": {
      "applicable_to": "Foreign embassy goods",
      "customs_duty": "100% exemption",
      "special_tax": "100% exemption",
      "vat": "100% exemption",
      "requires_certification": true,
      "issuing_body": "Ministry of Foreign Affairs"
    },
    "humanitarian_aid": {
      "applicable_to": "Disaster relief, medical aid",
      "customs_duty": "100% exemption",
      "special_tax": "100% exemption",
      "vat": "100% exemption",
      "requires_certification": true
    },
    "government_goods": {
      "applicable_to": "Government procurement",
      "customs_duty": "Variable (often exempted)",
      "special_tax": "Variable",
      "vat": "Often exempted",
      "requires_certification": true
    },
    "qip_goods": {
      "applicable_to": "Qualified Investment Project goods (factories, equipment)",
      "customs_duty": "Exemption or reduction (depends on QIP type)",
      "special_tax": "Often exempted for equipment",
      "vat": "Variable",
      "requires_certification": true,
      "issuing_body": "Council for the Development of Cambodia (CDC)"
    }
  },
  "calculation_order": {
    "step_1": "Verify currency and convert to KHR if needed (USD * exchange_rate)",
    "step_2": "Lookup HS code and confirm classification",
    "step_3": "Check origin and FTA documents (if applicable)",
    "step_4": "Apply Customs Duty rate (CD)",
    "step_5": "Apply Special Tax rate (ST)",
    "step_6": "Calculate subtotal (CIF + CD + ST)",
    "step_7": "Apply VAT on subtotal",
    "step_8": "Round UP final total to nearest 100 KHR",
    "formula": "FINAL = CEILING((CIF + (CIF*CD) + ((CIF+CD)*ST)) * 1.10 / 100) * 100"
  },
  "validation": {
    "cif_value_minimum": 0,
    "cif_value_maximum": 999999999,
    "hs_code_format": "^\\d{4,8}$",
    "hs_code_preferred_length": 8,
    "hs_code_lookup_source": "configs/hs_code_lookup.json",
    "currency_accepted": [
      "USD",
      "KHR"
    ],
    "origin_country_required_for": [
      "FTA claims",
      "Preferential rates"
    ],
    "certificate_types_accepted": [
      "ATIGA Form D",
      "CPTPP Certificate of Origin",
      "Other country-specific"
    ]
  },
  "exchange_rates": {
    "default_rate": 4022,
    "default_rate_currency_pair": "USD/KHR",
    "update_frequency": "Daily",
    "source": "Ministry of Economy and Finance (MEF)",
    "effective_date": "2026-02-19",
    "fallback_rate": 4020,
    "fallback_when": "If current rate unavailable"
  },
  "rounding": {
    "final_amount_method": "CEILING to nearest 100",
    "intermediate_amounts": "Also CEILING to nearest 100",
    "currency": "KHR",
    "rules_source": "configs/rounding_rules.json"
  },
  "output_format": {
    "structured": true,
    "format_type": "JSON",
    "required_fields": [
      "cif_value_khr",
      "customs_duty_amount",
      "special_tax_amount",
      "vat_amount",
      "total_payable",
      "calculation_steps"
    ],
    "optional_fields": [
      "hs_code",
      "origin_country",
      "fta_applied",
      "certificate_type",
      "exemptions"
    ]
  }
}