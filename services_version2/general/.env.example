# =====================================================
# GENERAL Q&A SERVICE (Port 8005)
# Copy to .env and fill in secrets before running.
# =====================================================

GENERAL_HOST=0.0.0.0
GENERAL_PORT=8005
GENERAL_RELOAD=false
GENERAL_WORKERS=4

# --- Vector store ---
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_API_KEY=
QDRANT_SEARCH_COLLECTION=gdce_docs
QDRANT_COLLECTION_NAME=gdce_docs

# --- Embeddings ---
QUERY_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_ENABLED=true

# --- Retrieval ---
TOP_K_DEFAULT=10
TOP_K_MAX=50
SIMILARITY_THRESHOLD=0.1

# --- Gemini (answer generation) — REQUIRED ---
GEMINI_ENABLED=true
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Optional vLLM fallback ---
VLLM_ENABLED=false
VLLM_HOST=localhost
VLLM_PORT=8000
VLLM_MODEL_NAME=llama3.1:8b

# --- Redis cache ---
REDIS_HOST=localhost
REDIS_PORT=6382

# --- Security / CORS ---
RATE_LIMIT_REQUESTS=100
MAX_PAYLOAD_SIZE_MB=10
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Logging / cache ---
LOG_LEVEL=INFO
QDRANT_TIMEOUT=30.0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# --- Docker overrides (uncomment when using docker compose) ---
# QDRANT_HOST=qdrant-general
# QDRANT_PORT=6333
# REDIS_HOST=redis-general
# REDIS_PORT=6379
