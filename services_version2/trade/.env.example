# =====================================================
# GEMINI API KEY (Choose either GEMINI_API_KEY or X_GOOG_API_KEY)
# =====================================================
GEMINI_API_KEY="your-gemini-api-key-here"
# X_GOOG_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.1-flash-lite"

# =====================================================
# TRADE QUERY SERVICE SETTINGS
# =====================================================
TRADE_SERVICE_HOST=127.0.0.1
TRADE_SERVICE_PORT=8004

# =====================================================
# DATA ACCESS LAYER (DAL) SETTINGS
# =====================================================
DAL_BASE_URL=http://dal-app:8000
DAL_API_KEY="your-dal-api-key-here"
DAL_DATASET_CODE=trade_volume
DAL_TIMEOUT=20.0
DAL_MAX_RETRIES=3
DAL_BACKOFF=1.0

# =====================================================
# SECURITY & RATE LIMITS
# =====================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_REQUESTS=60
MAX_PAYLOAD_SIZE_MB=1

# =====================================================
# SERVICES CONFIGURATION
# =====================================================
TRADE_PROMPTS_DIR=prompts
MIN_AVAILABLE_YEAR=2024
MAX_AVAILABLE_YEAR=2026
DEFAULT_SUGGESTION_PERIOD=2026
DEFAULT_SUGGESTION_COUNTRIES=China,Vietnam,Thailand
MIN_VALIDATION_YEAR=2000
MAX_VALIDATION_YEAR=2100
MIN_QUESTION_LENGTH=5
MAX_EXTRACTION_RETRIES=2
MAX_CHART_ITEMS=15
LOG_LEVEL=INFO
