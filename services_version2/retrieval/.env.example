# =====================================================
# RETRIEVAL SERVICE (Port 8003)
# Copy to .env and fill in secrets before running.
# =====================================================

RETRIEVAL_HOST=127.0.0.1
RETRIEVAL_PORT=8003
RETRIEVAL_RELOAD=false
RETRIEVAL_WORKERS=2

# --- Gemini — REQUIRED for LLM-assisted retrieval ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_SEARCH_COLLECTION=gdce_docs
QDRANT_COLLECTION_NAME=gdce_docs
QDRANT_HS_CODE_COLLECTION=gdce_hs_code
QDRANT_HS_CODE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Embeddings ---
QUERY_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_ENABLED=true
SIMILARITY_THRESHOLD=0.1
TOP_K_DEFAULT=10
TOP_K_MAX=50

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6381

# --- Security ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_REQUESTS=100
MAX_PAYLOAD_SIZE_MB=10
LOG_LEVEL=INFO

# --- Docker overrides (uncomment when using docker compose) ---
# RETRIEVAL_HOST=0.0.0.0
# QDRANT_HOST=qdrant-retrieval
# QDRANT_PORT=6333
# REDIS_HOST=redis-retrieval
# REDIS_PORT=6379
