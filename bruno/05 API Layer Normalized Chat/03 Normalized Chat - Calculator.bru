body:json {
  {
    "message": "Calculate import tax for live male cattle with CIF value 800 USD from Thailand"
  }
}

tests {
  test("returns normalized calculator response", function () {
    expect(res.status).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.property("intent");
    expect(body.message.content).to.be.an("array");
    expect(body.message.content[0].text).to.include("IMPORT TAX CALCULATION");
    expect(body.message.content[0].text).to.include("571,700 KHR");
    expect(body.message.content[0].text).to.not.include("[Amount]");
    expect(body.message.content[0].text).to.not.include("[Rate]");
  });
}
