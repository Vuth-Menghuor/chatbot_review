tests {
  test("returns normalized chat envelope", function () {
    expect(res.status).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.property("request_id");
    expect(body).to.have.property("session_id");
    expect(body).to.have.property("chat_id");
    expect(body.chat_id).to.equal(body.session_id);
    expect(body).to.have.property("status");
    expect(body).to.have.property("intent");
    expect(body).to.have.property("response");
    expect(body.response).to.have.property("content");
    expect(body).to.have.property("message");
    expect(body.message).to.have.property("role", "assistant");
    expect(body.message.content).to.be.an("array");
    expect(body.message.content[0]).to.have.property("type", "markdown");
    expect(body.message.content[0].text).to.equal(body.response.content);
    expect(body).to.not.have.property("answer");
    expect(body.citations).to.be.an("array");
  });
}
